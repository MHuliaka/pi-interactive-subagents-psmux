{
  "name": "pi-interactive-subagents",
  "version": "4.2.2",
  "description": "Cross-platform Pi RPC subagents with switchable conversations inside the main terminal tab",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "Amos Blomqvist",
  "repository": {
    "type": "git",
    "url": "https://github.com/amosblomqvist/pi-interactive-subagents"
  },
  "type": "module",
  "scripts": {
    "test": "node --experimental-transform-types --test test/*.test.ts",
    "test:integration": "node --experimental-transform-types --test --test-concurrency=1 test/integration/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "@sinclair/typebox": "*"
  },
  "pi": {
    "extensions": [
      "./pi-extension/subagents/index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "@sinclair/typebox": "^0.34.49",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
